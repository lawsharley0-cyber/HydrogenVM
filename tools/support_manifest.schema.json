{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hydrogenvm.local/schemas/support-manifest-v1.json",
  "title": "HydrogenVM support manifest",
  "type": "object",
  "required": ["version", "symbols", "classes", "selectors", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "const": 1 },
    "symbols": {
      "type": "array",
      "items": { "$ref": "#/$defs/symbolEntry" }
    },
    "classes": {
      "type": "array",
      "items": { "$ref": "#/$defs/classEntry" }
    },
    "selectors": {
      "type": "array",
      "items": { "$ref": "#/$defs/selectorEntry" }
    },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/flatEntry" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "status": {
      "type": "string",
      "enum": ["Real", "Approx", "Stub", "Unavailable", "implemented", "stub"]
    },
    "symbolEntry": {
      "type": "object",
      "required": ["name", "kind", "status", "provenance"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string", "enum": ["function", "data"] },
        "status": { "$ref": "#/$defs/status" },
        "provenance": { "type": "string" }
      },
      "additionalProperties": false
    },
    "classEntry": {
      "type": "object",
      "required": ["name", "status", "provenance"],
      "properties": {
        "name": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "provenance": { "type": "string" },
        "methods": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "selectorEntry": {
      "type": "object",
      "required": ["name", "status", "provenance"],
      "properties": {
        "name": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "provenance": { "type": "string" }
      },
      "additionalProperties": false
    },
    "flatEntry": {
      "type": "object",
      "required": ["kind", "name", "status", "provenance"],
      "properties": {
        "kind": { "type": "string", "enum": ["symbol", "class", "selector"] },
        "name": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "provenance": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
