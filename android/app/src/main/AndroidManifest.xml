<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No internet permission: games stay offline, as on iPhone with "Allow internet" off. -->
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:label="HydrogenVM"
        android:icon="@drawable/icon"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:extractNativeLibs="false"
        android:largeHeap="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".GameActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:screenOrientation="fullSensor" />
    </application>
</manifest>
