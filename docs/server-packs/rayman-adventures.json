{
  "schema_version": 1,
  "game": "Rayman Adventures",
  "notes": "Offline loopback stand-in for retired Ubisoft UbiServices login/session endpoints. Preserves offline play without circumventing purchases or DRM.",
  "hosts": [
    "public-ubiservices.ubi.com",
    "*.ubiservices.ubi.com",
    "*.ubi.com",
    "*.ubisoft.com",
    "localhost",
    "127.0.0.1"
  ],
  "default_status": 404,
  "state": {
    "profile_id": "00000000-0000-4000-8000-000000000001",
    "session_id": "00000000-0000-4000-8000-000000000002",
    "player_name": "OfflinePlayer",
    "save_revision": 1
  },
  "rules": [
    {
      "method": "POST",
      "path_regex": "^/v[1-3]/profiles/sessions$",
      "status": 200,
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "platformType": "android",
        "ticket": "hvm-offline-ticket-{{now_unix}}",
        "twoFactorAuthenticationTicket": null,
        "profileId": "{{state.profile_id}}",
        "userId": "{{state.profile_id}}",
        "nameOnPlatform": "{{state.player_name}}",
        "environment": "Prod",
        "expiration": "2099-01-01T00:00:00.0000000Z",
        "spaceId": "rayman-adventures-offline",
        "clientIp": "127.0.0.1",
        "clientIpCountry": "US",
        "serverTime": "{{now_iso}}",
        "sessionId": "{{state.session_id}}",
        "sessionKey": "aHZtLW9mZmxpbmUtc2Vzc2lvbi1rZXk=",
        "rememberMeTicket": null
      }
    },
    {
      "method": "GET",
      "path_regex": "^/v[1-3]/spaces/.*/parameters$",
      "status": 200,
      "body": {
        "parameters": {
          "offlineMode": true,
          "maintenance": false,
          "minClientVersion": "1.0.0"
        }
      }
    },
    {
      "method": "GET",
      "path_regex": "^/v[1-3]/profiles/[^/]+$",
      "status": 200,
      "body": {
        "profileId": "{{state.profile_id}}",
        "userId": "{{state.profile_id}}",
        "nameOnPlatform": "{{state.player_name}}",
        "platformType": "android"
      }
    },
    {
      "method": "PUT",
      "path_regex": "^/v[1-3]/profiles/[^/]+/storage$",
      "status": 200,
      "persist_body_key": "cloud_save",
      "state_updates": {
        "last_saved_at": "{{now_iso}}"
      },
      "body": {
        "status": "ok",
        "savedAt": "{{now_iso}}"
      }
    },
    {
      "method": "GET",
      "path_regex": "^/v[1-3]/profiles/[^/]+/storage$",
      "status": 200,
      "body": {
        "profileId": "{{state.profile_id}}",
        "data": "{{state.cloud_save}}"
      }
    },
    {
      "method": "*",
      "path_prefix": "/v1/store",
      "status": 503,
      "body": {
        "error": "store_unavailable_offline"
      }
    }
  ]
}
